# Pakistani Payment Gateway Keys (Safepay / PayFast)
# Copy this file to .env and fill in your actual production keys.
# NEVER commit the .env file to version control.

# Safepay Keys
SAFEPAY_API_KEY=your_safepay_api_key_here
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret_here
SAFEPAY_ENVIRONMENT=sandbox # sandbox or production

# PayFast Keys
PAYFAST_MERCHANT_ID=your_payfast_merchant_id_here
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key_here
PAYFAST_ENVIRONMENT=sandbox # sandbox or production
